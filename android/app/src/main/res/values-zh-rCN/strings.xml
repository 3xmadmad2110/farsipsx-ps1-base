    <string name="settings_audio_resampling">音频重采样</string>
    <string name="settings_summary_audio_resampling">当以非 100% 速度运行时，按目标速度重采样音频而不是丢弃帧。以较小的性能代价产生好得多的快进/慢放音频。</string>
    <string name="settings_general_sync_to_host_refresh_rate">同步到主机刷新率</string>
    <string name="settings_summary_general_sync_to_host_refresh_rate">当启用垂直同步和音频重采样时，调整模拟速度使主机刷新率匹配主机的刷新率。这会带来最流畅的动画，代价是可能使模拟速度提高不到 1%。</string>
    <string name="settings_sustained_performance_mode">持续性能模式</string>
    <string name="settings_summary_sustained_performance_mode">启用 Android 的持续性能模式。在某些设备上长时间游戏可获得更稳定的帧率。</string>
    <string name="title_activity_game_directories">编辑游戏目录</string>
    <string name="settings_game_directories">游戏目录</string>
    <string name="settings_summary_game_directories">更改用于搜索游戏的目录列表。</string>
    <string name="game_directories_scanning_subdirectories">扫描子目录。</string>
    <string name="game_directories_not_scanning_subdirectories">不扫描子目录。</string>
    <string name="settings_display_all_frames">最佳帧节奏</string>
