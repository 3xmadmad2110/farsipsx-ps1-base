    <string name="settings_summary_save_state_on_exit">关机或退出时自动保存模拟器状态。下次可以直接从上次离开的位置继续。</string>
    <string name="settings_summary_load_patch_codes"><![CDATA[从 cheats/<游戏名>.cht 加载 PCSXR 格式的补丁代码。可在游戏内切换代码开关。]]></string>
    <string name="settings_apply_compatibility_settings">应用兼容性设置</string>
    <string name="settings_summary_apply_compatibility_settings">当游戏不支持某些增强功能时，自动禁用这些功能。</string>
    <string name="settings_summary_video_sync">开启此项可使 DuckStation 的刷新率与当前显示器或屏幕匹配。当无法同步时（例如非 100% 速度运行）会自动禁用垂直同步。</string>
    <string name="settings_video_sync">垂直同步</string>
    <string name="settings_cpu_overclocking">CPU 超频</string>
    <string name="settings_cdrom_region_check">区域检查</string>
    <string name="settings_summary_cdrom_region_check">防止模拟器读取错误区域的光盘。通常可以安全关闭。</string>
    <string name="settings_cdrom_preload_image_to_ram">预加载镜像到内存</string>
    <string name="settings_summary_preload_image_to_ram">将游戏镜像加载到内存。适用于可能在游戏过程中变得不稳定的网络路径。在某些情况下还能消除游戏开始播放音轨时的卡顿。</string>
    <string name="settings_pgxp_vertex_cache">PGXP 顶点缓存</string>
    <string name="settings_summary_pgxp_vertex_cache">当通过内存追踪顶点失败时，使用屏幕坐标作为后备。可提高 PGXP 兼容性。</string>
    <string name="settings_pgxp_cpu_mode">PGXP CPU 模式</string>
    <string name="settings_summary_pgxp_cpu_mode">尝试通过 CPU 追踪顶点操作。某些游戏需要此选项才能使 PGXP 生效。性能代价很高。</string>
    <string name="settings_cpu_recompiler_icache">CPU 重编译器 ICache</string>
    <string name="settings_summary_cpu_recompiler_icache">决定是否在重编译器中模拟 CPU 的指令缓存。以较小的性能代价提高精确度。如果游戏运行太快，可尝试启用此选项。</string>
    <string name="settings_cpu_recompiler_fastmem">CPU 重编译器快速内存访问</string>
    <string name="settings_summary_cpu_recompiler_fastmem">通过页错误和回填使客户机内存访问更高效。如果在你的设备上不稳定则禁用。</string>
    <string name="settings_presented_frame_limit">呈现帧数限制</string>
    <string name="settings_logging_level">日志级别</string>
    <string name="settings_log_to_file">日志写入文件</string>
    <string name="settings_summary_log_to_file">将日志消息写入用户目录下的 duckstation.log。仅用于调试，因为它会拖慢模拟。</string>
    <string name="settings_log_to_logcat">日志写入 Logcat</string>
    <string name="settings_summary_log_to_logcat">将日志消息写入 Android 消息记录器。仅在用 adb 连接电脑时有用。</string>
    <string name="settings_volume">音量</string>
    <string name="settings_summary_volume">控制模拟器声音输出的音量。</string>
    <string name="settings_fast_forward_volume">快进音量</string>
    <string name="settings_summary_fast_forward_volume">控制快进时模拟器声音输出的音量。设为 0 即快进时静音。</string>
    <string name="settings_mute_all_sound">全部静音</string>
    <string name="settings_summary_mute_all_sound">阻止模拟器发出任何声音。</string>
    <string name="settings_mute_on_fast_forward">快进时静音</string>
    <string name="settings_summary_mute_on_fast_forward">快进或使用涡轮增压时静音音频。由于 PS1 的音频会随游戏一起加速（并变调），可能听起来不舒适，开启此项可让音乐静音而非变调失真。受 PS1 硬件架构限制，无法做到加速时音乐完全保持原速原调。</string>
    <string name="settings_mute_cd_audio">静音 CD 音频</string>
    <string name="settings_summary_mute_cd_audio">强制静音来自 CD-ROM 的 CD-DA 和 XA 音频。可用于关闭某些游戏的背景音乐。</string>
    <string name="settings_audio_backend">音频后端</string>
    <string name="settings_audio_buffer_size">音频缓冲区大小</string>
    <string name="settings_summary_audio_buffer_size">决定音频从生成到输出到扬声器的延迟。较小的值可降低延迟，但模拟速度的波动会导致卡顿。</string>
    <string name="settings_audio_sync">音频同步</string>
    <string name="settings_summary_audio_sync">根据音频后端拉取音频帧来节流模拟速度。如果模拟过快，这有助于消除噪音或爆音。非 100% 速度运行时会自动禁用同步。</string>
    <string name="settings_controller_type">控制器类型</string>
    <string name="settings_enable_analog_mode_on_reset">重置时启用模拟模式</string>
    <string name="settings_touchscreen_controller_view">触摸控制器视图</string>
    <string name="settings_auto_hide_touchscreen_controller">自动隐藏触摸控制器</string>
    <string name="settings_summary_auto_hide_touchscreen_controller">检测到外部控制器时隐藏触摸控制器。</string>
    <string name="settings_vibrate_on_press">按键震动</string>
    <string name="settings_summary_vibrate_on_press">触摸按钮按下时启用短暂震动。需要在设备上启用“触摸时震动”。</string>
    <string name="settings_enable_vibration">设备震动</string>
    <string name="settings_summary_enable_vibration">将游戏的震动反馈转发到手机的震动马达。</string>
    <string name="settings_memory_card_1_type">记忆卡 1 类型</string>
    <string name="settings_memory_card_2_type">记忆卡 2 类型</string>
    <string name="settings_crop_mode">裁剪模式</string>
    <string name="settings_aspect_ratio">宽高比</string>
    <string name="settings_linear_upscaling">线性放大</string>
    <string name="settings_integer_upscaling">整数放大</string>
    <string name="settings_summary_linear_upscaling">将主机画面放大到屏幕时使图像更平滑。</string>
    <string name="settings_summary_integer_upscaling">在显示区域添加边距，以确保主机像素与主机像素之间的比率为整数。在某些 2D 游戏中可获得更清晰的图像。</string>
    <string name="settings_summary_osd_show_messages">在发生事件时显示屏幕消息，例如创建/加载存档、截图等。</string>
    <string name="settings_summary_osd_show_speed">在屏幕右上角以百分比显示系统当前的模拟速度。</string>
    <string name="settings_summary_osd_show_fps">在屏幕右上角显示游戏的内部帧率。</string>
    <string name="settings_summary_osd_show_vps">在屏幕右上角显示系统每秒显示的帧数（或垂直同步数）。</string>
    <string name="settings_cdrom_read_speedup">CD-ROM 读取加速</string>
    <string name="settings_summary_cdrom_read_speedup">按指定倍数加速 CD-ROM 读取。仅适用于倍速读取，播放音频时被忽略。可能提高某些游戏的加载速度，但会破坏其他游戏。</string>
    <string name="settings_summary_console_fast_boot">跳过 BIOS 启动界面/片头，直接启动游戏。通常可以安全启用，但某些游戏会出错。</string>
    <string name="settings_msaa">多重采样抗锯齿</string>
    <string name="settings_true_color">真彩色渲染（24 位，禁用抖动）</string>
    <string name="settings_summary_true_color">这能产生更漂亮的渐变，代价是某些颜色看起来略有不同。禁用此选项也会启用抖动。大多数游戏兼容此选项。</string>
    <string name="settings_scaled_dithering">缩放抖动（将抖动图案缩放到分辨率）</string>
    <string name="settings_summary_scaled_dithering">将抖动图案缩放到模拟 GPU 的分辨率倍数。这使得在更高分辨率下抖动图案不那么明显。通常可以安全启用，仅硬件渲染器支持。</string>
    <string name="settings_disable_interlacing">禁用隔行扫描（强制逐行渲染/扫描）</string>
    <string name="settings_summary_disable_interlacing">强制帧的渲染和显示为逐行模式。这通过以 480p 渲染 480i 游戏来消除梳状效应。通常可以安全启用。</string>
    <string name="settings_texture_filtering">纹理过滤</string>
    <string name="settings_force_ntsc_timings">强制 NTSC 时序（PAL 上 60Hz）</string>
    <string name="settings_summary_force_ntsc_timings">当主机处于 PAL 模式时使用 NTSC 帧时序，强制 PAL 游戏以 60Hz 运行。</string>
    <string name="settings_widescreen_hack">宽屏破解</string>
    <string name="settings_summary_widescreen_hack">将顶点位置在屏幕空间中缩放到宽屏宽高比，本质上是将 3D 游戏的视野从 4:3 增加到 16:9。并非所有游戏都兼容。</string>
    <string name="settings_force_4_3_for_24bit">24 位显示强制 4:3</string>
    <string name="settings_summary_force_4_3_for_24bit">显示 24 位内容（通常是 FMV）时切换回 4:3 显示宽高比。</string>
    <string name="settings_chroma_smoothing_24bit">24 位显示的色度平滑</string>
    <string name="settings_summary_chrome_smoothing_24bit">平滑 24 位内容（通常是 FMV）中颜色过渡处的块状感。仅适用于硬件渲染器。</string>
    <string name="settings_pgxp_geometry_correction">PGXP 几何校正</string>
    <string name="settings_summary_pgxp_geometry_correction"><![CDATA[减少 PS1 游戏中常见的“摇晃”多边形和“扭曲”纹理。>仅适用于硬件渲染器。可能并非所有游戏都兼容。]]></string>
    <string name="settings_pgxp_culling_correction">PGXP 剔除校正</string>
    <string name="settings_summary_pgxp_culling_correction">提高多边形剔除的精度，减少几何体中的孔洞。需要启用几何校正。</string>
    <string name="settings_pgxp_texture_correction">PGXP 纹理校正</string>
    <string name="settings_summary_pgxp_texture_correction">对纹理坐标和颜色使用透视正确的插值，拉直扭曲的纹理。需要启用几何校正。</string>
    <string name="settings_pgxp_preserve_projection_precision">PGXP 保留投影精度</string>
    <string name="settings_summary_pgxp_preserve_projection_precision">为 PGXP 启用额外精度。可能改善某些游戏的视觉效果，但会破坏其他游戏。</string>
    <string name="settings_pgxp_depth_buffer">PGXP 深度缓冲</string>
    <string name="settings_summary_pgxp_depth_buffer">通过将像素与 PGXP 的深度值进行测试，尝试减少多边形 Z 冲突。兼容性低，但在某些游戏中效果很好。</string>
